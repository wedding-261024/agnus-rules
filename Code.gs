/** AGNUS API: Deploy as Web app, execute as owner, access anyone. */
const SHEET_USERS='Users', SHEET_VOTES='Responses', SHEET_LOG='AuditLog';
const VERSION='2026-01-25-v1.1';
const HEADERS={Users:['Name','Role','InviteCode','PinSalt','PinHash','Failed','LockedUntil','CreatedAt'],Responses:['Name','ArticleId','Choice','Comment','UpdatedAt','Version'],AuditLog:['At','Name','Action','Detail']};
function setup(){const ss=SpreadsheetApp.getActiveSpreadsheet();Object.keys(HEADERS).forEach(n=>{let s=ss.getSheetByName(n)||ss.insertSheet(n);if(s.getLastRow()===0)s.appendRow(HEADERS[n]);s.setFrozenRows(1);});}
function doGet(){return HtmlService.createHtmlOutput('AGNUS API is running');}
function doPost(e){let id='',res;try{const p=JSON.parse(e.parameter.payload||'{}');id=String(p.requestId||'');res=handle_(p);}catch(err){res={ok:false,error:String(err.message||err)};}const origin=PropertiesService.getScriptProperties().getProperty('SITE_ORIGIN');if(!origin) return HtmlService.createHtmlOutput('Configure SITE_ORIGIN first');const msg=JSON.stringify({source:'agnus-api',requestId:id,...res}).replace(/</g,'\\u003c');return HtmlService.createHtmlOutput('<!doctype html><html><body><script>window.parent.postMessage('+msg+','+JSON.stringify(origin)+');<\/script></body></html>');}
function handle_(p){setup();const lock=LockService.getScriptLock();lock.waitLock(20000);try{return dispatch_(p);}finally{lock.releaseLock();}}
function dispatch_(p){const op=String(p.action||'');if(op==='register')return register_(p);if(op==='login')return login_(p);const name=session_(p.token);if(!name)return{ok:false,error:'로그인이 만료되었습니다. 다시 로그인해 주세요.'};if(op==='responses')return{ok:true,name,responses:myResponses_(name)};if(op==='save')return save_(name,p);return{ok:false,error:'알 수 없는 요청입니다.'};}
function rows_(n){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(n);return{s,rows:s.getDataRange().getValues()};}
function user_(name){const {s,rows}=rows_(SHEET_USERS);const i=rows.findIndex((r,k)=>k>0&&String(r[0]).trim()===name);return{i,s,row:i<0?null:rows[i]};}
function validName_(name){return /^[가-힣a-zA-Z ]{2,30}$/.test(name);}
function validPin_(pin){return /^\d{4}$/.test(String(pin));}
function hash_(salt,pin){return Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,salt+':'+pin));}
function newToken_(){return Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');}
function register_(p){const name=String(p.name||'').trim(),pin=String(p.pin||''),invite=String(p.invite||'').trim();if(!validName_(name)||!validPin_(pin)||!invite)return{ok:false,error:'이름, 4자리 PIN, 개인 초대코드를 확인해 주세요.'};const u=user_(name);if(!u.row)return{ok:false,error:'명단에 없는 이름입니다. 관리자에게 문의해 주세요.'};if(u.row[4])return{ok:false,error:'이미 등록된 계정입니다. 로그인해 주세요.'};if(String(u.row[2]).trim()!==invite)return{ok:false,error:'초대코드가 일치하지 않습니다.'};const salt=newToken_();u.s.getRange(u.i+1,4,1,5).setValues([[salt,hash_(salt,pin),0,'',new Date()]]);u.s.getRange(u.i+1,3).clearContent();log_(name,'register','');return sessionCreate_(name);}
function login_(p){const name=String(p.name||'').trim(),pin=String(p.pin||'');if(!validName_(name)||!validPin_(pin))return{ok:false,error:'이름과 4자리 PIN을 확인해 주세요.'};const u=user_(name);if(!u.row||!u.row[4])return{ok:false,error:'등록된 계정이 아닙니다.'};const now=Date.now();if(u.row[6]&&new Date(u.row[6]).getTime()>now)return{ok:false,error:'로그인 시도가 잠시 제한되었습니다. 30분 뒤 다시 시도하세요.'};if(hash_(String(u.row[3]),pin)!==String(u.row[4])){const n=Number(u.row[5]||0)+1;u.s.getRange(u.i+1,6,1,2).setValues([[n,n>=5?new Date(now+30*60*1000):'']]);return{ok:false,error:'로그인 정보가 올바르지 않습니다.'};}u.s.getRange(u.i+1,6,1,2).setValues([[0,'']]);return sessionCreate_(name);}
function sessionCreate_(name){const token=newToken_();CacheService.getScriptCache().put('session_'+token,name,21600);log_(name,'login','');return{ok:true,token,name,responses:myResponses_(name)};}
function session_(token){return token?CacheService.getScriptCache().get('session_'+String(token)):null;}
function myResponses_(name){return rows_(SHEET_VOTES).rows.slice(1).filter(r=>String(r[0])===name).map(r=>({articleId:String(r[1]),choice:String(r[2]),comment:String(r[3]),updatedAt:String(r[4])}));}
function save_(name,p){const id=String(p.articleId||''),choice=String(p.choice||''),comment=String(p.comment||'').trim();if(!/^ART(14|22|23|26|28|29|31|32|33)$/.test(id))return{ok:false,error:'투표 대상이 아닌 조항입니다.'};if(!['찬성','반대','보류'].includes(choice))return{ok:false,error:'찬성/반대/보류 중 하나를 선택하세요.'};if(comment.length>2000)return{ok:false,error:'의견은 2,000자 이내로 입력해 주세요.'};const {s,rows}=rows_(SHEET_VOTES);const row=[name,id,choice,comment,new Date(),VERSION];const i=rows.findIndex((r,k)=>k>0&&String(r[0])===name&&String(r[1])===id);if(i<0)s.appendRow(row);else s.getRange(i+1,1,1,6).setValues([row]);log_(name,'save',id);return{ok:true,responses:myResponses_(name)};}
function log_(name,action,detail){SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_LOG).appendRow([new Date(),name,action,detail]);}
